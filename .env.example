# Database — Neon / Supabase / any PostgreSQL provider
DATABASE_URL="postgresql://username:password@host:5432/renewpeptides?sslmode=require"

# JWT secret — generate with: openssl rand -base64 64
JWT_SECRET="your-very-long-random-secret-here-minimum-32-chars"

# Admin credentials (hashed password stored separately — see README)
# Run `npx ts-node scripts/hash-password.ts` to generate a bcrypt hash
ADMIN_EMAIL="admin@renewpeptides-us.com"
ADMIN_PASSWORD_HASH="$2b$12$..."   # bcrypt hash of your chosen password

# Base URL (used in QR code links)
NEXT_PUBLIC_BASE_URL="https://renewpeptides-us.com"

# Rate limit: max verification attempts per IP per 15-minute window
RATE_LIMIT_MAX="10"
